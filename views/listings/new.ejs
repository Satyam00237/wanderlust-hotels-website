<% layout("/layouts/boilerplate.ejs") %>
    <div class="row">
        <div class="col-8 offset-2">

            <br /><br />


            <h3>Add new Listings</h3>
            <form action="/listings" method="POST">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" placeholder="enter title" type="text" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>

                    <textarea name="listing[description]" class="form-control"></textarea>

                </div>


                <div class="mb-3">
                    <label for="Image" class="form-label">Image Link</label>
                    <input name="listing[image]" placeholder="Enter image URL/link" type="text" class="form-control" />

                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price " class="form-label">Price</label>

                        <input name="listing[price]" placeholder="Enter price" type="number" class="form-control" />
                    </div>


                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>

                        <input name="listing[country]" placeholder="Enter country" type="text" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>

                    <input name="listing[location]" placeholder="Enter location" type="text" class="form-control" />
                </div>





                <br /><br />
                <button class="btn btn-dark">Add</button>

            </form>

        </div>
    </div>